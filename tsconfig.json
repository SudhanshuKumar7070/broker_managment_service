{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],

    /* Module Resolution */
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],

    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Interop */
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "lib"],
  "exclude": ["node_modules", "dist"]
}
